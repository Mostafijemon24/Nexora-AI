# Copy to deploy/.env on the server. deploy/install.sh writes this file for you.

# ── required ──────────────────────────────────────────────────────────────
# The API's own address, without https://. Its DNS A record must point at this server.
API_DOMAIN=api.example.com
# Where the web app is served from (comma separated). Browsers at these origins may call the API.
APP_ORIGINS=https://app.example.com
POSTGRES_PASSWORD=
# Generate these three with:  docker compose run --rm migrate node src/cli.ts keygen
LICENSE_SIGNING_KEY=
DATA_ENCRYPTION_KEY=
HASH_SECRET=

# "proxy" runs Caddy on ports 80 and 443. Leave empty when another web server already uses them.
COMPOSE_PROFILES=proxy
# Local port the API listens on (127.0.0.1 only), for an existing web server to forward to.
API_PORT=8787

# ── optional ──────────────────────────────────────────────────────────────
# Email. Without SMTP_URL, codes and invitations are written to the API log instead of sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Nexora AI <no-reply@example.com>"

# Sign-in integrations, one block per provider you offer: LINKEDIN, HUBSPOT, SALESFORCE, GOOGLE_CALENDAR.
# In the provider's developer app, register this redirect address (li, hs, sf or gc):
#   https://<API_DOMAIN>/v1/integrations/<li|hs|sf|gc>/callback
# OAUTH_LINKEDIN_CLIENT_ID=
# OAUTH_LINKEDIN_CLIENT_SECRET=
# OAUTH_HUBSPOT_CLIENT_ID=
# OAUTH_HUBSPOT_CLIENT_SECRET=
# OAUTH_SALESFORCE_CLIENT_ID=
# OAUTH_SALESFORCE_CLIENT_SECRET=
# OAUTH_GOOGLE_CALENDAR_CLIENT_ID=
# OAUTH_GOOGLE_CALENDAR_CLIENT_SECRET=

# Where this server runs, shown to users as the data region (free text).
# REGION=Singapore

# Prices used to work out what AI requests cost, in US dollars per million tokens: [input, output].
# Adds to, or corrects, the built-in list (see backend/src/ai/pricing.ts). Gemini is not built in.
# AI_PRICES={"gemini-2.0-flash": [0.10, 0.40]}

# API versions, only if the defaults stop working.
# LINKEDIN_API_VERSION=202608
# SALESFORCE_API_VERSION=v60.0
# WHATSAPP_API_VERSION=v21.0
