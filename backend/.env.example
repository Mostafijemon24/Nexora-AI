# ── required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora_dev
# Ed25519 seed (base64, 32 bytes) that signs entitlement tokens. Generate both keys with: npm run cli -- keygen
LICENSE_SIGNING_KEY=
# AES-256 key (base64, 32 bytes) that encrypts provider keys and OAuth tokens at rest.
DATA_ENCRYPTION_KEY=
# HMAC secret (any long random string) for hashing license keys, session tokens and transfer codes.
HASH_SECRET=

# ── optional ──────────────────────────────────────────────────────────────
PORT=8787
# Public URL of this API (used for OAuth callbacks) and of the web app (CORS, CSRF, post-OAuth redirect).
PUBLIC_API_URL=http://localhost:8787
APP_ORIGINS=http://localhost:1420
# Redis enables the BullMQ worker (email, maintenance) and shared rate limits. Without it both run in-process.
REDIS_URL=
# SMTP for transfer codes. Without it, codes are written to the server log (development only).
SMTP_URL=
MAIL_FROM="Nexora AI <no-reply@nexora.example>"
# Set to 1 only when the API sits behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY=0

# Default model per provider (bring-your-own-key). OpenRouter's model is chosen per workspace in Settings.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-opus-5-5

# OAuth apps, one block per integration you offer: LINKEDIN, HUBSPOT, SALESFORCE, GOOGLE_CALENDAR
# OAUTH_LINKEDIN_CLIENT_ID=
# OAUTH_LINKEDIN_CLIENT_SECRET=
# OAUTH_LINKEDIN_SCOPES="openid profile"
