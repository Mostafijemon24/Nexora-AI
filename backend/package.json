{
  "name": "nexora-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@hono/node-server": "^2.1.11",
    "bullmq": "^6.7.8",
    "hono": "^4.13.21",
    "imapflow": "^2.12.2",
    "ioredis": "^6.1.0",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
